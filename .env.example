# Copy to .env and fill in. Never commit .env.
# Every variable the app reads is listed here with a safe placeholder.

# --- Database (docker compose provides this to the api container) ---
DATABASE_URL=postgresql+psycopg://app:app@db:5432/app
# Host port for the dockerised Postgres (5433 avoids clashing with a local Postgres on 5432)
DB_HOST_PORT=5433

# --- Tenancy ---
# Used when a request sends no X-Tenant-Id header
DEFAULT_TENANT=demo

# --- AI provider: gemini | ollama | fake (fake = deterministic, tests only) ---
AI_PROVIDER=gemini
# Free AI Studio key (Google account, no credit card): https://aistudio.google.com/apikey
GEMINI_API_KEY=your-ai-studio-key-here
# Free-tier Flash model with image input (gemini-2.5-flash is routed here from 2026-12-01)
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
# Supports task_type=SEMANTIC_SIMILARITY (gemini-embedding-2 does not)
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIMENSIONS=768
GEMINI_TIMEOUT_S=60

# Local path (docker compose --profile local up)
OLLAMA_URL=http://ollama:11434
OLLAMA_VISION_MODEL=moondream
OLLAMA_EMBED_MODEL=all-minilm
OLLAMA_TIMEOUT_S=180

# --- Cost + rate control ---
# Budget guard on list-price-equivalent spend (config/pricing.yaml). Jobs stop before exceeding it.
AI_BUDGET_USD=1.00
# Client-side rate limits. Check your free-tier quota at https://aistudio.google.com/rate-limit
VISION_RPM=8
EMBED_RPM=30

# --- Vision pipeline ---
# Below this confidence a valid result is flagged for review instead of accepted
VISION_MIN_CONFIDENCE=0.70
# Repair attempts after a schema-invalid answer (then the image fails + alert)
VISION_MAX_REPAIRS=2
VISION_MAX_SIDE_PX=1024
IMAGES_DIR=data/images

# --- Background jobs ---
JOB_MAX_ATTEMPTS=3
JOB_BACKOFF_BASE_S=2
JOB_BACKOFF_MAX_S=60
WORKER_POLL_INTERVAL_S=1
WORKER_STALE_AFTER_S=300

# --- Ops ---
# Optional webhook (e.g. Discord/Slack incoming webhook) for job-failure alerts
ALERT_WEBHOOK_URL=
LOG_LEVEL=INFO
# Requests with a larger body get a 413
MAX_BODY_BYTES=1000000
