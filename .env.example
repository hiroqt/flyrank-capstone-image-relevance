# Copy to .env and fill in. Never commit .env.
# Every variable the app reads is listed here with a safe placeholder.

# --- Database (docker compose provides this to the api container) ---
DATABASE_URL=postgresql+psycopg://app:app@db:5432/app
# Host port for the dockerised Postgres (5433 avoids clashing with a local Postgres on 5432)
DB_HOST_PORT=5433

# --- Tenancy ---
# Used when a request sends no X-Tenant-Id header
DEFAULT_TENANT=demo

# --- AI provider: gemini | ollama | fake (fake = deterministic, tests only) ---
AI_PROVIDER=gemini
# Free AI Studio key (Google account, no credit card)
GEMINI_API_KEY=your-ai-studio-key-here
# Use the current Flash / embedding model ids shown in AI Studio
GEMINI_VISION_MODEL=gemini-flash-model-id
GEMINI_EMBED_MODEL=gemini-embedding-model-id

# Local path (docker compose --profile local up)
OLLAMA_URL=http://ollama:11434
OLLAMA_VISION_MODEL=moondream
OLLAMA_EMBED_MODEL=all-minilm

# --- Cost + rate control ---
AI_BUDGET_USD=1.00
VISION_RPM=8
EMBED_RPM=60

# --- Ops ---
# Optional webhook (e.g. Discord/Slack incoming webhook) for job-failure alerts
ALERT_WEBHOOK_URL=
LOG_LEVEL=INFO
# Requests with a larger body get a 413
MAX_BODY_BYTES=1000000
